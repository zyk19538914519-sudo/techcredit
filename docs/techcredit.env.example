# techcredit 数据层凭证模板
# 用法：复制为 /root/projects/techcredit/.env 并 chmod 600；填值后由 config.load_env_file 读取或 export 到环境。
# 已有 Key 不在此填明文，按注释从原位置同步。

# ---- A 已有（同步即可，勿重复申请） ----
# 天眼查 MCP：从 Mac ~/.tyc/config.json 的 headers.Authorization 取值（mcpk2_ 开头）
TYC_TOKEN=
# 智慧芽：沿用文件 /root/.patsnap_mcp_key，无需变量
PATSNAP_KEY_FILE=/root/.patsnap_mcp_key
# XCrawl：从 Mac ~/.zshrc 的 XCRAWL_API_KEY 取值（xc- 开头）
XCRAWL_API_KEY=
# Tavily：从 Mac ~/.hermes/.env 第59行 或 ~/.hermes/config.yaml mcp_servers.tavily.env 取值（tvly- 开头）
TAVILY_API_KEY=
# Firecrawl：从 Mac ~/.hermes/config.yaml mcp_servers.firecrawl.env 取值（fc- 开头），抓官网全文
FIRECRAWL_API_KEY=
# Metaso 秘塔搜索：从 Mac ~/.zshrc 的 METASO_API_KEY 取值（mk- 开头），中文搜索
METASO_API_KEY=
# 东方财富妙想金融数据：从 Mac ~/.zshrc 的 MX_APIKEY 取值（mkt_ 开头），财务/上市维度
MX_APIKEY=

# ---- B 自助注册（免费起步） ----
# 企查查 MCP（agent.qcc.com，已接入；Key 已存 /root/.qcc_mcp_key，配置快照 docs/qcc_mcp.json）
QCC_API_KEY=
# CNIPR 开放平台（MCP sk- Key 已存 /root/.cnipr_mcp_key；REST 需 OAuth client_id/openid/access_token，配额待授权）
CNIPR_API_KEY=
CNIPR_CLIENT_ID=
CNIPR_CLIENT_SECRET=
CNIPR_OPENID=
CNIPR_ACCESS_TOKEN=
# AKShare 财务（免费无 Key，venv: /root/projects/techcredit/.venv）
AKSHARE_PYTHON=/root/projects/techcredit/.venv/bin/python
# ImportYeti（美/墨提单，My Account→Settings→API Credits Settings）
IMPORTYETI_API_KEY=
# Serper（备选搜索，serper.dev，一次性2500次免费）
SERPER_API_KEY=
# 高德 / 百度地图（二选一，地址真实性）
AMAP_KEY=
BAIDU_MAP_AK=
# Semantic Scholar（可选，论文交叉）
S2_API_KEY=

# ---- C 商务采购（按需） ----
# 剑鱼标讯（中标正文，jianyu360.cn 数据API，审核开通）
JIANYU_API_KEY=
JIANYU_API_BASE=
# 天眼查开放平台（批量/高并发，open.tianyancha.com）
TYC_OPENAPI_TOKEN=
# 企查查开放平台（按次计费，openapi.qcc.com，Token=Md5(key+Timespan+SecretKey)）
QCC_APPKEY=
QCC_SECRET=
# 腾道海关（全球提单，tendata.net）
TENDATA_API_KEY=
# IT桔子 / 新榜（可选）
ITJUZI_API_KEY=
NEWRANK_API_KEY=

# ---- 既有配置（不动） ----
WEKNORA_ENV_FILE=/root/weknora-mcp/weknora-mcp.env
WEKNORA_KB_NAME=techcredit-dossiers